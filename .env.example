# Environment
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is used when DATABASE_URL is unset. Production must use PostgreSQL.
# DATABASE_URL=postgres://user:pass@host:5432/routeledger

# OpenRouteService / HeiGIT — get a key at https://account.heigit.org/
# Use base URL https://api.heigit.org/openrouteservice (not the deprecated api.openrouteservice.org)
OPENROUTESERVICE_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_TIMEOUT_S=20

# Set true for local UI/dev without an ORS key (labeled fake geometry)
USE_FAKE_PROVIDER=true

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Optional AI insights (not implemented in baseline; keep false)
AI_INSIGHTS_ENABLED=false
